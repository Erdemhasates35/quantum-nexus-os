# Shared Nexus / Honeycomb runtime configuration
# Never commit real secrets.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
FLASH_ETHEREUM_RPC=
FLASH_POLYGON_RPC=
FLASH_GNOSIS_RPC=
FLASH_SOLANA_RPC=
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
FLASH_MIN_PROFIT_USD=1
FLASHLOAN_LIVE_EXECUTION=false
SOLANA_PRIVATE_KEY_B58=
FLASH_MAX_SLIPPAGE_BPS=30
FLASH_MAX_GAS_USD=25
FLASH_MAX_QUOTE_AGE_MS=1500
FLASH_MAX_PRIORITY_FEE_WEI=1000000000
FLASH_MAX_FEE_WEI=
FLASH_RECEIVER_ADDRESS=
FLASH_PRIVATE_KEY=

# Sponsored execution: the signer/relayer fronts native gas.
# Reimbursement is made atomically from the arbitrage asset after repayment
# and minimum-profit checks pass.
FLASH_SPONSOR_MODE=relayer_reimbursed
FLASH_SPONSOR_ADDRESS=
FLASH_SPONSOR_FEE_ASSET_UNITS=0
FLASH_MIN_PROFIT_ASSET_UNITS=0
