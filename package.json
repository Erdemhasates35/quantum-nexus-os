{
  "name": "quantum-nexus-os",
  "version": "15.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run nexus-sync",
    "start": "node server.js",
    "server-dev": "nodemon server.js",
    "lint": "next lint && black . 2>/dev/null || true",
    "nexus-init": "bash start_nexus.sh",
    "ghost-mode": "python3 main.py --mode ghost",
    "nexus-sync": "uv sync && git gc --aggressive --prune=now 2>/dev/null || true",
    "mev-scan": "node scripts/jito-bundle-monitor.js 2>/dev/null || true",
    "security-audit": "npm audit fix && npx snyk test 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@solana/web3.js": "^1.95.4",
    "@vercel/analytics": "^1.0.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "framer-motion": "^11.2.4",
    "lucide-react": "^0.378.0",
    "next": "14.2.3",
    "pino": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "nodemon": "^3.1.0",
    "typescript": "^5.4.5"
  },
  "author": "erdem hasates",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  }
}
